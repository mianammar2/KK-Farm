        <item name="android:statusBarColor">#163D22</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorAccent">#C9A23F</item>
        <item name="android:windowSplashScreenBackground">#163D22</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_brand</item>
    </style>
</resources>
